# Optional environment variables for running the FastAPI server directly.
# Agenda configures its embedded server from the native Settings window.

# Path to the SQLite DB file. Default: ./data/agenda.db relative to the
# working directory.
# AGENDA_DB_PATH=./data/agenda.db

# Bind host and port for the FastAPI/uvicorn process.
# AGENDA_HOST=127.0.0.1
# AGENDA_PORT=8551
